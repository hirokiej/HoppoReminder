ul.flex.border-b.list-none.bg-white.rounded-t-lg.shadow-sm
  - tabs.each do |tab|
    li.mr-1
      - active = current_page?(tab[:path])
      = link_to tab[:name], tab[:path], \
      class: "inline-block py-2 px-5 rounded-t-lg font-medium transition-colors duration-200 \
      #{active ? 'bg-gray-100 text-blue-600 border-b-2 border-blue-600 shadow-inner' \
      : 'text-gray-600 border-b-2 border-transparent hover:text-blue-600 hover:border-blue-300'}"
